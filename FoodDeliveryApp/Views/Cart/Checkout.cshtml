@using FoodDeliveryApp.Models
@model List<CartItem>

@{
    ViewData["Title"] = "Order Summary";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <h2 class="mb-4 text-center">🧾 Order Summary</h2>

    @if (Model != null && Model.Count > 0)
    {
        <div class="row">

            <!-- LEFT SIDE: CART ITEMS -->
            <div class="col-md-8">

                @foreach (var item in Model)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="row g-0">

                            <div class="col-md-3">
                                <img src="@item.ImageUrl"
                                     class="img-fluid rounded-start"
                                     style="height:120px; width:100%; object-fit:cover;" />
                            </div>

                            <div class="col-md-6">
                                <div class="card-body">
                                    <h5>@item.FoodName</h5>
                                    <p class="text-muted">Quantity: @item.Quantity</p>
                                    <p class="text-success fw-bold">₹ @item.Price</p>
                                </div>
                            </div>

                            <div class="col-md-3 d-flex align-items-center justify-content-center">
                                <strong>₹ @(item.Price * item.Quantity)</strong>
                            </div>

                        </div>
                    </div>
                }

            </div>

            <!-- RIGHT SIDE: TOTAL + CHECKOUT -->
            <div class="col-md-4">

                <div class="card shadow p-3">

                    <h4 class="mb-3">💰 Bill Summary</h4>

                    <hr />

                    <p>
                        Items Total:
                        <strong>
                            ₹ @Model.Sum(x => x.Price * x.Quantity)
                        </strong>
                    </p>

                    <p>
                        Delivery Fee: <strong>Free</strong>
                    </p>

                    <hr />

                    <h5>
                        Grand Total:
                        <span class="text-success">
                            ₹ @Model.Sum(x => x.Price * x.Quantity)
                        </span>
                    </h5>

                    <form asp-action="PlaceOrder" asp-controller="Cart" method="post">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-success w-100">
                            Place Order 🚀
                        </button>
                    </form>
                    <a asp-action="Index" asp-controller="Cart"
                           class="btn btn-outline-secondary w-100 mt-2">
                        Back to Cart
                    </a>

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="alert alert-warning text-center">
            🛒 Your cart is empty
        </div>
    }

</div>